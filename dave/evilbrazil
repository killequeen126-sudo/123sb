    local function runph3()
        local char = plr.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local hrp = char.HumanoidRootPart
        hrp.Anchored = false
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and not part.CanCollide then part.CanCollide = true end
        end
        spawnsspots(2)
        curspotindex = 2
        local oldCF = getSurfaceCFrame(sspots[2].CFrame)
        hrp.CFrame = oldCF
        task.wait(0.5)

        local c4count = 0
        while c4count < 4 do
            local currentC4 = nil
            for _, v in pairs(workspace:GetChildren()) do
                if v.Name == "C4" then currentC4 = v; break end
            end
            if currentC4 then
                lockstate(char, currentC4.CFrame)
                task.wait(0.3)
                if currentC4:FindFirstChildOfClass("ProximityPrompt") then fireproximityprompt(currentC4:FindFirstChildOfClass("ProximityPrompt")) end
                waittool("C4", 5)
                unlockstate(char)
                
                local t = tick()
                while currentC4.Parent and tick() - t < 2 do task.wait(0.1) end
                if not currentC4.Parent then c4count = c4count + 1 end
                task.wait(0.2)
            else
                if c4count > 0 then break end
                task.wait(0.1)
            end
        end
        hrp.CFrame = oldCF
        task.wait(0.2)

        local ghosts = workspace:FindFirstChild("ExplosiveGhosts") or workspace:WaitForChild("ExplosiveGhosts", 15)
        if ghosts then
            local timeout = tick() + 15
            while #ghosts:GetChildren() == 0 and tick() < timeout do task.wait(0.1) end
            for _, v in pairs(ghosts:GetChildren()) do
                if v:IsA("BasePart") and v:FindFirstChild("SurfaceAppearance") == nil then
                    local c4Tool = plr.Backpack:FindFirstChild("C4") or char:FindFirstChild("C4")
                    if c4Tool and c4Tool.Parent == plr.Backpack then
                        char.Humanoid:EquipTool(c4Tool)
                        task.wait(0.2)
                    end
                    lockstate(char, v.CFrame)
                    task.wait(0.3)
                    if v:FindFirstChildOfClass("ProximityPrompt") then fireproximityprompt(v:FindFirstChildOfClass("ProximityPrompt")) end
                    task.wait(0.2)
