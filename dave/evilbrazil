        createw(ph4boxcenter * CFrame.new(0, 0, -12.5), Vector3.new(25, 25, 1)) 
        createw(ph4boxcenter * CFrame.new(12.5, 0, 0), Vector3.new(1, 25, 25))  
        createw(ph4boxcenter * CFrame.new(-12.5, 0, 0), Vector3.new(1, 25, 25)) 
    end

