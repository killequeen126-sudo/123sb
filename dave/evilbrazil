        end

        local function createw(cf, size)
            local p = Instance.new("Part")
            p.Name = "Phase4BoxPart"
            p.Size = size
            p.CFrame = cf
            p.Anchored = true
            p.CanCollide = true
            p.Color = Color3.fromRGB(100, 100, 100)
