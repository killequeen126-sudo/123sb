    task.spawn(function()
        local lasthit = 0
        local ph1state = "idle"
        local slappedhand = nil
        local slapstart = 0
        
        while true do
            task.wait(0.1)
            if flagph1 then
                local char = plr.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    local attacknear = false
                    
                    for _, obj in ipairs(workspace:GetChildren()) do
                        if obj:IsA("BasePart") and obj.Name == "Part" and obj.BrickColor.Name == "Really red" and obj.Material == Enum.Material.Neon then
                            if (obj.Position - hrp.Position).Magnitude < 50 then
                                attacknear = true
                                break
                            end
                        end
                    end

                    local mimic = nil
                    if workspace:FindFirstChild("bossStorage") and workspace.bossStorage:FindFirstChild("leftHand") and workspace.bossStorage.leftHand:FindFirstChild("PointerMimic") then
                        local m = workspace.bossStorage.leftHand.PointerMimic
                        if m:FindFirstChild("TouchInterest") then mimic = m end
                    end

                    if attacknear then
                        if ph1state ~= "dodging" then
                            hrp.Anchored = false
                            nextspot(hrp)
                            ph1state = "dodging"
                            slappedhand = nil
                        end
                    elseif mimic then
                        local lantern = char:FindFirstChild("Lantern") or plr.Backpack:FindFirstChild("Lantern")
                        if lantern and lantern.Parent == plr.Backpack then
                            char.Humanoid:EquipTool(lantern)
                            task.wait(0.1)
                            lantern = char:FindFirstChild("Lantern")
                        end

                        if lantern then
                            if ph1state ~= "attacking" or mimic ~= slappedhand then
                                hrp.Anchored = true
                                slapstart = tick()
                                slappedhand = mimic
                                ph1state = "attacking"
                            end
                            
                            local timediff = tick() - slapstart
                            local jumpoff = 0
                            if timediff < 0.2 then jumpoff = 5 * (1 - (timediff / 0.2)) end
                            
                            hrp.CFrame = mimic.CFrame * CFrame.new(0, jumpoff, 6.8)
                            
                            if tick() - lasthit >= 0.2 then
                                lantern:Activate()
                                lasthit = tick()
                            end
                        end
                    else
                        if ph1state ~= "idle" then
                            hrp.Anchored = false
                            hrp.CFrame = getSurfaceCFrame(sspots[curspotindex].CFrame)
                            ph1state = "idle"
                            slappedhand = nil
                        end
                    end
                end
            else
                ph1state = "idle"
                slappedhand = nil
            end
        end
    end)

    task.spawn(function()
        local curnail = nil
        local firstrotation = nil
        local locktime = 0
        local lasthit = 0
        local launchednails = {}
        local nailspawntimes = {}
        local searchtime = 0
        local flagdodgelight = false

