            p.Material = Enum.Material.SmoothPlastic
            setSmoothSurface(p)
            p.Parent = dodgeFolder
        end

        createw(ph4boxcenter * CFrame.new(0, -12.5, 0), Vector3.new(25, 1, 25)) 
        createw(ph4boxcenter * CFrame.new(0, 12.5, 0), Vector3.new(25, 1, 25))  
