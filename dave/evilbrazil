                            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and not part.CanCollide then part.CanCollide = true end
                        end
                    else
                        local nailcount = 0
                        if workspace:FindFirstChild("bossStorage") then
                            for _, v in pairs(workspace.bossStorage:GetChildren()) do
                                if (v.Name:find("thicc") or v.Name == "nail") and v:FindFirstChild("object") then
                                    nailcount = nailcount + 1
                                    if not nailspawntimes[v] then nailspawntimes[v] = tick() end
                                end
                            end
                        end

                        if curnail then
                            local obj = curnail:FindFirstChild("object")
                            local rotated = false
                            
                            if not obj or not obj.Parent then
                                rotated = true
                            elseif nailcount <= 3 then
                                rotated = true
                            elseif firstrotation and (tick() - locktime > 0.2) then
                                local currotation = obj.Orientation
                                local diffx = math.abs((currotation.X - firstrotation.X + 180) % 360 - 180)
                                local diffy = math.abs((currotation.Y - firstrotation.Y + 180) % 360 - 180)
                                local diffz = math.abs((currotation.Z - firstrotation.Z + 180) % 360 - 180)
                                if diffx > 0.1 or diffy > 0.1 or diffz > 0.1 then rotated = true end
                            end
                            
                            if rotated then
                                table.insert(launchednails, curnail)
                                curnail = nil
                                firstrotation = nil
                                if not hrp.Anchored then hrp.Anchored = true end
                                hrp.AssemblyLinearVelocity = Vector3.zero
                                hrp.AssemblyAngularVelocity = Vector3.zero
                                hrp.CFrame = getSurfaceCFrame(sspots[2].CFrame)
                                for _, part in pairs(char:GetDescendants()) do
                                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and not part.CanCollide then part.CanCollide = true end
                                end
                                searchtime = tick() + 0.3
                            else
                                local lantern = char:FindFirstChild("Lantern") or plr.Backpack:FindFirstChild("Lantern")
                                if lantern and lantern.Parent == plr.Backpack then
                                    char.Humanoid:EquipTool(lantern)
                                    task.wait(0.1)
                                    lantern = char:FindFirstChild("Lantern")
                                end

                                if lantern and obj and obj.Parent then
                                    if hrp.Anchored then hrp.Anchored = false end
                                    for _, part in pairs(char:GetDescendants()) do
                                        if part:IsA("BasePart") then
                                            part.CanCollide = false
                                            pcall(function() part.CollisionGroup = "IgnoreCharacters" end)
                                        end
                                    end
                                    if humanoid then
                                        humanoid.PlatformStand = false
                                        pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
                                    end
                                    hrp.CFrame = obj.CFrame * CFrame.new(0, -2, 0) * CFrame.Angles(math.rad(90), 0, 0)
                                    hrp.AssemblyLinearVelocity = Vector3.zero
                                    hrp.AssemblyAngularVelocity = Vector3.zero
                                    if tick() - lasthit > 0.1 then
                                        lantern:Activate()
                                        lasthit = tick()
                                    end
                                else
                                    curnail = nil
                                end
                            end
                        else
                            if not hrp.Anchored then hrp.Anchored = true end
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                            hrp.CFrame = getSurfaceCFrame(sspots[2].CFrame)
                            for _, part in pairs(char:GetDescendants()) do
                                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and not part.CanCollide then part.CanCollide = true end
                            end
                            
                            for i = #launchednails, 1, -1 do
                                if not launchednails[i] or not launchednails[i].Parent then table.remove(launchednails, i) end
                            end
                            for k, v in pairs(nailspawntimes) do
                                if not k.Parent then nailspawntimes[k] = nil end
                            end

                            if nailcount > 3 and tick() >= searchtime then
                                if workspace:FindFirstChild("bossStorage") then
                                    for _, v in pairs(workspace.bossStorage:GetChildren()) do
                                        if (v.Name:find("thicc") or v.Name == "nail") and v:FindFirstChild("object") then
                                            local inblacklist = false
                                            for _, oldnail in ipairs(launchednails) do
                                                if oldnail == v then inblacklist = true; break end
                                            end
                                            
                                            local nailobj = v:FindFirstChild("object")
                                            if not inblacklist and nailobj then
                                                local animationcontrollernail = v:FindFirstChild("AnimationController")
                                                local animator = animationcontrollernail and animationcontrollernail:FindFirstChild("Animator")
                                                local spawntimenail = nailspawntimes[v] or tick()
                                                local oldenough = (tick() - spawntimenail > 1.5)
                                                
                                                if oldenough and animator and #animator:GetPlayingAnimationTracks() == 0 then
                                                    curnail = v
                                                    firstrotation = nailobj.Orientation
                                                    locktime = tick()
                                                    break
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            else
                if not flagph3 and not flagph4 then
                    local char = plr.Character
                    if char then
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        local humanoid = char:FindFirstChildOfClass("Humanoid")
                        if humanoid then humanoid.AutoRotate = true end 
                        if hrp then hrp.Anchored = false end
                        for _, part in pairs(char:GetDescendants()) do
                            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and not part.CanCollide then part.CanCollide = true end
                        end
                    end
                end
                curnail = nil
                firstrotation = nil
                launchednails = {}
                nailspawntimes = {}
                searchtime = 0
            end
        end
    end)
